# Deployed in /etc/caddy/Caddyfile on the VPS (exxo-vps). The receiver runs on pve2 LXC 115
# and is reached over WireGuard at 10.8.0.8. DNS: *.sites.exxo.world -> VPS (Cloudflare, DNS only).
# After editing: sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy

feed.sites.exxo.world {
    request_body {
        max_size 256KB
    }
    # only the two endpoints the receiver implements are reachable
    @ok path /ingest /health
    handle @ok {
        reverse_proxy 10.8.0.8:8787
    }
    handle {
        respond 404
    }
}
