# Add this block to your existing Caddyfile (replace the hostname with your real one),
# then: sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
# The DNS A/AAAA record for the hostname must already point at the VPS.

logs.example.com {
	encode zstd gzip
	request_body {
		max_size 256KB
	}
	# only the two endpoints the receiver implements are reachable
	@ok path /ingest /health
	handle @ok {
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		respond 404
	}
}
